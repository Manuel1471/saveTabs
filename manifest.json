{
    "name": "Save Tabs",
    "description": "Efficiently manage your browser tabs: save, organize, and restore multiple tabs with ease.",
    "version": "1.2.0",
    "manifest_version": 3,
    "action": {
      "default_popup": "saveTabs.html",
      "default_icon": "saveTabs.png"
    },
    "background": {
      "service_worker": "background.js",
      "scripts": ["background.js"]
    },
    "optional_host_permissions": ["<all_urls>"],
    "permissions": [
      "tabs",
      "storage"
    ],
    "browser_specific_settings": {
      "gecko": {
        "id": "manuel-garccia@hotmail.com",
        "strict_min_version": "121.0"
      }
    }
}
