{
    "name": "Save Tabs",
    "description": "Efficiently manage your browser tabs: save, organize, and restore multiple tabs with ease.",
    "version": "1.2.1",
    "manifest_version": 3,
    "action": {
      "default_popup": "saveTabs.html",
      "default_icon": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "96": "icons/icon-96.png",
        "128": "icons/icon-128.png"
      }
    },
    "icons": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png",
      "512": "icons/icon-512.png"
    },
    "background": {
      "service_worker": "background.js",
      "scripts": ["background.js"]
    },
    "options_ui": {
      "page": "options.html",
      "open_in_tab": true
    },
    "optional_host_permissions": ["<all_urls>"],
    "permissions": [
      "tabs",
      "storage",
      "alarms"
    ],
    "commands": {
      "save-current-tabs": {
        "suggested_key": { "default": "Ctrl+Shift+S", "mac": "MacCtrl+Shift+S" },
        "description": "Save tabs from the current window"
      },
      "open-library": {
        "suggested_key": { "default": "Ctrl+Shift+L", "mac": "MacCtrl+Shift+L" },
        "description": "Open Save Tabs library"
      }
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "manuel-garccia@hotmail.com",
        "strict_min_version": "121.0"
      }
    }
}
